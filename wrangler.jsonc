{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hoppborg",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hoppborg-database","database_id": "752d1ca7-01b4-4f65-b747-61a76101b1bf",
			// Run `wrangler d1 create my-emdash-site` and paste the ID here
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "hoppborg-media","preview_bucket_name": "hoppborg-media",
		},
	],
	"observability": {
		"enabled": true,
	},
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
}